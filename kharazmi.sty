%%
%%  kharazmi.sty
%%  Styling Package and Metadata Engine for Kharazmi University Thesis Template
%%  Designed to conform to Kharazmi University guidelines (1402)
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kharazmi}[2026/11/12 v1.0 Kharazmi Thesis Styling and Metadata Package]

% -----------------------------------------------------------------------------
% Package Options for Typography Selection
% -----------------------------------------------------------------------------
\newif\if@usevazir \@usevazirfalse
\newif\if@usenazanin \@usenazaninfalse
\newif\if@usebzar \@usebzartrue

\DeclareOption{vazir}{\@usevazirtrue\@usenazaninfalse\@usebzarfalse}
\DeclareOption{vazirmatn}{\@usevazirtrue\@usenazaninfalse\@usebzarfalse}
\DeclareOption{bnazanin}{\@usevazirfalse\@usenazanintrue\@usebzarfalse}
\DeclareOption{bzar}{\@usevazirfalse\@usenazaninfalse\@usebzartrue}
\ProcessOptions\relax

% -----------------------------------------------------------------------------
% Load XePersian (Must be loaded after all other packages)
% -----------------------------------------------------------------------------
\@ifpackageloaded{xepersian}{}{%
  \RequirePackage[extrafootnotefeatures]{xepersian}%
}

% Use hyphen (-) as hierarchical separator matching Kharazmi guidelines
\SepMark{-}

% -----------------------------------------------------------------------------
% Font Configuration
% Primary body font: B Zar 13pt (Scale=1.08 on 12pt base)
% Inline English font: Times New Roman 10.5pt (Scale=0.875 on 12pt base)
% Full English page font: Times New Roman 12pt (Scale=1.0)
% Heading fonts: B Titr, B Zar Bold
% -----------------------------------------------------------------------------
\if@usevazir
  \settextfont[
    Scale=1.0,
    BoldFont={Vazirmatn Bold},
    ItalicFont={Vazirmatn},
    ItalicFeatures={FakeSlant=0.18},
    BoldItalicFont={Vazirmatn Bold},
    BoldItalicFeatures={FakeSlant=0.18}
  ]{Vazirmatn}
  \setlatintextfont[Scale=0.875]{Times New Roman}
  \deflatinfont\enfullfont[Scale=1.0]{Times New Roman}
  \defpersianfont\titrfont[Scale=1.0, BoldFont={Vazirmatn Bold}]{Vazirmatn Bold}
  \defpersianfont\zarfont[Scale=1.0]{Vazirmatn}
  \defpersianfont\nazaninfont[Scale=1.0]{Vazirmatn}
\else
  \if@usenazanin
    \settextfont[
      Mapping=persian-digits,
      Scale=1.08,
      BoldFont={B Nazanin Bold},
      ItalicFont={B Nazanin},
      ItalicFeatures={FakeSlant=0.18},
      BoldItalicFont={B Nazanin Bold},
      BoldItalicFeatures={FakeSlant=0.18}
    ]{B Nazanin}
    \setlatintextfont[Scale=0.875]{Times New Roman}
    \deflatinfont\enfullfont[Scale=1.0]{Times New Roman}
    \defpersianfont\titrfont[Scale=1.0, BoldFont={B Titr}]{B Titr}
    \defpersianfont\zarfont[Mapping=persian-digits, Scale=1.08]{B Zar}
    \defpersianfont\nazaninfont[Mapping=persian-digits, Scale=1.08]{B Nazanin}
  \else
    % Default: B Zar matching official guidelines Table 3-2
    \settextfont[
      Mapping=persian-digits,
      Scale=1.08,
      BoldFont={B Zar Bold},
      ItalicFont={B Zar},
      ItalicFeatures={FakeSlant=0.18},
      BoldItalicFont={B Zar Bold},
      BoldItalicFeatures={FakeSlant=0.18}
    ]{B Zar}
    \setlatintextfont[Scale=0.875]{Times New Roman}
    \deflatinfont\enfullfont[Scale=1.0]{Times New Roman}
    \defpersianfont\titrfont[Scale=1.0, BoldFont={B Titr}]{B Titr}
    \defpersianfont\zarfont[Mapping=persian-digits, Scale=1.08]{B Zar}
    \defpersianfont\nazaninfont[Mapping=persian-digits, Scale=1.08]{B Nazanin}
  \fi
\fi

% Nastaliq font (optional if available)
\IfFontExistsTF{IranNastaliq}{%
  \defpersianfont\nastaliqfont[Scale=1.2]{IranNastaliq}%
}{%
  \defpersianfont\nastaliqfont[Scale=1.08]{B Zar}%
}

