% 4. Committee Approval / Defense Sheet
\newcommand{\makeApproval}{%
  \clearpage
  \thispagestyle{empty}
  \begin{center}
    \includegraphics[height=2.3cm]{khu_logo.png}\par
    \vspace{0.2cm}
    {\fontsize{13pt}{16pt}\selectfont\bfseries \@university}\par
    {\fontsize{12pt}{15pt}\selectfont\bfseries \@faculty}\par
    \vspace{0.4cm}
    {\fontsize{15pt}{19pt}\selectfont\bfseries\titrfont صورت‌جلسه دفاع از \@projectlabel}\par
  \end{center}
  \vspace{0.5cm}
  \noindent
  جلسه دفاع از \@projectlabel\ \@thesisdegree\ آقای/خانم \textbf{\@authorname}
  \ifx\@studentid\@empty\else\ به شماره دانشجویی \textbf{\@studentid}\fi\
  در رشته \textbf{\@field}\ifx\@major\@empty\else\ گرایش \textbf{\@major}\fi\
  با عنوان:
  \begin{center}
    \vspace{0.2cm}
    {\fontsize{14pt}{19pt}\selectfont\bfseries «\@thesistitle»}\par
  \end{center}
  \vspace{0.3cm}
  \noindent
  در تاریخ \textbf{\@thesisdate} با حضور هیئت داوران تشکیل و با درجه .................... و نمره ............ به تصویب رسید.
  \par
  \vspace{0.8cm}
  \noindent
  \textbf{هیئت داوران:}
  \par\vspace{0.4cm}
  \begin{center}
    \renewcommand{\arraystretch}{2.2}
    \begin{tabular}{p{4.5cm}p{4.5cm}p{3.5cm}}
      \textbf{سمت} & \textbf{نام و نام خانوادگی} & \textbf{امضا} \\
      استاد راهنما & \ifx\@supervisorrank\@empty\else\@supervisorrank\ \fi\@supervisor & \\
      \ifx\@secondsupervisor\@empty\else
        استاد راهنمای دوم & \ifx\@secondsupervisorrank\@empty\else\@secondsupervisorrank\ \fi\@secondsupervisor & \\
      \fi
      \ifx\@advisor\@empty\else
        استاد مشاور & \ifx\@advisorrank\@empty\else\@advisorrank\ \fi\@advisor & \\
      \fi
      داور داخلی & \ifx\@internaljudgerank\@empty\else\@internaljudgerank\ \fi\@internaljudge & \\
      داور خارجی & \ifx\@externaljudgerank\@empty\else\@externaljudgerank\ \fi\@externaljudge & \\
    \end{tabular}
  \end{center}
  \clearpage
}

% 5. Declaration of Originality Page
\newcommand{\makeDeclaration}{%
  \clearpage
  \thispagestyle{empty}
  \begin{center}
    {\fontsize{15pt}{19pt}\selectfont\bfseries\titrfont تعهدنامه اصالت اثر}\par
  \end{center}
  \vspace{0.8cm}
  \noindent
  اینجانب \textbf{\@authorname} دانش‌آموخته مقطع \@thesisdegree\ در رشته \@field\
  \ifx\@major\@empty\else گرایش \@major\fi\ دانشگاه خوارزمی، تأیید می‌نمایم که کلیه نتایج مندرج در این \@projectlabel\
  حاصل پژوهش و فعالیت علمی خود اینجانب بوده و در صورت استفاده از دستاوردها و نتایج علمی دیگران،
  مشخصات کامل منبع استناد شده، بر اساس موازین و ضوابط علمی در متن پایان‌نامه و فهرست منابع ذکر شده است.
  همچنین این اثر قبلاً برای دریافت هیچ مدرک تحصیلی دیگری در این دانشگاه یا سایر مؤسسات ارائه نگردیده است.
  \par
  \vspace{2.5cm}
  \begin{flushleft}
    \textbf{نام و نام خانوادگی دانشجو:} \@authorname\par
    \vspace{0.3cm}
    \textbf{امضا و تاریخ:} \hspace{4cm}
  \end{flushleft}
  \clearpage
}

