% 1. Persian Outer Cover Page
\newcommand{\makefaCover}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{center}
      \includegraphics[height=3.2cm]{khu_logo.png}\par
      \vspace{0.4cm}
      {\fontsize{14pt}{17pt}\selectfont\bfseries \@ministry}\par
      \vspace{0.2cm}
      {\fontsize{16pt}{20pt}\selectfont\bfseries\titrfont \@university}\par
      \vspace{0.2cm}
      {\fontsize{13pt}{16pt}\selectfont\bfseries \@faculty}\par
      \vspace{0.15cm}
      {\fontsize{12pt}{15pt}\selectfont\bfseries \@department}\par
      \vspace{1.0cm}
      {\fontsize{13pt}{16pt}\selectfont\bfseries \@projectlabel\ برای دریافت درجه \@thesisdegree}\par
      \vspace{0.2cm}
      {\fontsize{12pt}{15pt}\selectfont\bfseries در رشته \@field\ifx\@major\@empty\else\ (گرایش \@major)\fi}\par
      \vspace{1.2cm}
      {\fontsize{13pt}{16pt}\selectfont\bfseries عنوان:}\par
      \vspace{0.3cm}
      {\fontsize{17pt}{24pt}\selectfont\bfseries\titrfont \@thesistitle}\par
      \vspace{1.4cm}
      {\fontsize{12pt}{15pt}\selectfont نگارش:}\par
      \vspace{0.2cm}
      {\fontsize{14pt}{17pt}\selectfont\bfseries \@authorname}\par
      \vspace{1.0cm}
      {\fontsize{12pt}{15pt}\selectfont استاد(ان) راهنما:}\par
      \vspace{0.2cm}
      {\fontsize{13pt}{16pt}\selectfont\bfseries \ifx\@supervisorrank\@empty\else\@supervisorrank\ \fi\@supervisor}\par
      \ifx\@secondsupervisor\@empty\else
        \vspace{0.1cm}
        {\fontsize{13pt}{16pt}\selectfont\bfseries \ifx\@secondsupervisorrank\@empty\else\@secondsupervisorrank\ \fi\@secondsupervisor}\par
      \fi
      \ifx\@advisor\@empty\else
        \vspace{0.5cm}
        {\fontsize{12pt}{15pt}\selectfont استاد(ان) مشاور:}\par
        \vspace{0.2cm}
        {\fontsize{13pt}{16pt}\selectfont\bfseries \ifx\@advisorrank\@empty\else\@advisorrank\ \fi\@advisor}\par
        \ifx\@secondadvisor\@empty\else
          \vspace{0.1cm}
          {\fontsize{13pt}{16pt}\selectfont\bfseries \ifx\@secondadvisorrank\@empty\else\@secondadvisorrank\ \fi\@secondadvisor}\par
        \fi
      \fi
      \vfill
      {\fontsize{12pt}{15pt}\selectfont\bfseries \@thesisdate}\par
    \end{center}
  \end{titlepage}
  \clearpage
}

